# Env example — copy to `.env.local` (never commit real secrets)

# App
NODE_ENV=development
API_BASE_URL=http://127.0.0.1:8000
WEB_ORIGIN=http://127.0.0.1:3000

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Direct Postgres URL for SQL migrations (Dashboard → Database → URI)
SUPABASE_DB_URL=

# US market data
MASSIVE_API_KEY=

# OpenAI
OPENAI_API_KEY=

# SEC - no API key; declared User-Agent
SEC_USER_AGENT="investing-insight/0.1 contact@example.com"

# Post-MVP macro
FRED_API_KEY=

# Post-MVP M01 ops — production schedulers stay disabled on Free plan
# OPS_PITR_CONFIRMED removed: Free plan has no PITR; use dump/restore evidence instead
