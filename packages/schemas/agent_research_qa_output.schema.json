{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_research_qa_output.v0.1",
  "type": "object",
  "required": ["status", "failed_claims", "warnings", "claim_verdicts"],
  "additionalProperties": false,
  "properties": {
    "status": {"type": "string", "enum": ["PASS", "FAIL"]},
    "failed_claims": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "claim_verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "evidence_id", "support"],
        "properties": {
          "claim_id": {"type": "string"},
          "evidence_id": {"type": "string"},
          "support": {"type": "string", "enum": ["SUPPORTED", "UNSUPPORTED"]}
        }
      }
    }
  }
}
