{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_industry_output.v0.1",
  "type": "object",
  "required": ["industry_id", "attractiveness_view", "dimension_notes", "risks", "evidence_refs", "unsupported_or_missing"],
  "additionalProperties": false,
  "properties": {
    "industry_id": {"type": "string"},
    "attractiveness_view": {"type": "string"},
    "dimension_notes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "demand": {"type": "string"},
        "capex": {"type": "string"},
        "supply": {"type": "string"},
        "pricing": {"type": "string"},
        "margin": {"type": "string"},
        "bottleneck": {"type": "string"}
      },
      "required": ["demand", "capex", "supply", "pricing", "margin", "bottleneck"]
    },
    "risks": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "unsupported_or_missing": {"type": "array", "items": {"type": "string"}}
  }
}
